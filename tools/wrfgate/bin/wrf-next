#!/bin/bash
# Do the next step for a fire, or say what it is waiting for.
#   wrf-next FIRE            check, submit the next step, or show progress
#   wrf-next FIRE --yes      submit the full simulation without asking
#   wrf-next FIRE --retry    redo a step that ended without a result
#   wrf-next FIRE --spec DIR use these settings instead of your latest ones
# Steps: 1 weather and map files (WPS) · 2 start files (real.exe) · 3 a 2-minute test run · 4 the simulation.
source "$(dirname "$(readlink -f "$0")")/../lib/wrfgate.sh"
[[ $# -ge 1 && $1 != -* ]] || { sed -n '2,7p' "$0"; exit 1; }
wg_need_person
export WG_BIN=$(dirname "$(readlink -f "$0")")
wg_modules || exit 1
python3 -m wrfgate.nextstep "$@"
