#!/bin/bash
# Monitor every job the gating system submitted (gate C, gate D, production runs).
#   wrf-watch                     all fires, all users, every job ever submitted
#   wrf-watch FIRE                one fire
#   wrf-watch --active            only queued and running jobs
#   wrf-watch --mine              only your jobs
#   wrf-watch --every 60          refresh every 60 s until Ctrl-C (combine with the others)
# Shows Slurm state, elapsed and limit, simulated time reached, % of the window, s/step, ETA, and warnings:
# log idle over 30 min, won't finish in its time limit, pending reason, failed/timeout, gate results.
source "$(dirname "$(readlink -f "$0")")/../lib/wrfgate.sh"
EVERY=""; ARGS=()
while [[ $# -gt 0 ]]; do case $1 in --every) EVERY=$2; shift 2;; -h|--help) sed -n '2,9p' "$0"; exit 0;; *) ARGS+=("$1"); shift;; esac; done
if [[ -z $EVERY ]]; then python3 -m wrfgate.watch "${ARGS[@]}"; exit; fi
[[ $EVERY =~ ^[0-9]+$ && $EVERY -ge 15 ]] || wg_die "--every takes seconds, at least 15"
while true; do OUT=$(python3 -m wrfgate.watch "${ARGS[@]}"); clear; echo "$OUT"; echo; echo "refreshing every ${EVERY}s; Ctrl-C to stop"; sleep "$EVERY"; done
