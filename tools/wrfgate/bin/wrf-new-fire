#!/bin/bash
# Create a fire record: wrf-new-fire FIRE (--from-namelist FILE | --start T --end T --ignition T --lat X --lon Y) [--note TEXT] [--fuel-layer DIR] [--min-edge-km N] [--replace]
source "$(dirname "$(readlink -f "$0")")/../lib/wrfgate.sh"
[[ $# -ge 1 && $1 != -* ]] || wg_die "usage: wrf-new-fire FIRE (--from-namelist FILE | --start 'YYYY-MM-DD HH:MM' --end ... --ignition ... --lat X --lon Y) [--replace]"
FIRE=$1; shift
[[ $FIRE =~ ^[A-Z0-9_]+$ ]] || wg_die "fire names are UPPER_CASE letters, digits and _ (e.g. CANYON_2025)"
wg_need_person; wg_start "$FIRE" "$@"
D=$WRF_ROOT/fires/$FIRE; mkdir -p "$D"/{inputs,specs,runs}
REPLACE=0; ARGS=()
for a in "$@"; do [[ $a == --replace ]] && REPLACE=1 || ARGS+=("$a"); done
if [[ -f $D/fire.yaml ]]; then
  [[ $REPLACE == 1 ]] || wg_die "$D/fire.yaml exists; use --replace to supersede it (the old record is kept)"
  chmod u+w "$D/fire.yaml"; mv "$D/fire.yaml" "$D/fire.yaml.replaced_$(wg_stamp)"
fi
python3 -m wrfgate.record "$D/fire.yaml" "$FIRE" "${ARGS[@]}" || wg_die "record not written"
echo "created_by: $(wg_by)" >> "$D/fire.yaml"
chmod a-w "$D/fire.yaml"
echo "record: $D/fire.yaml"
